      "validateSsl": true,
      "requestMethod": "GET",
      "acceptedResponseStatusCodes": [{ "statusClass": "STATUS_CLASS_2XX" }]
    },
    "contentMatchers": [{ "content": "<div id=\"root\">", "matcher": "CONTAINS_STRING" }],
    "period": "300s",
