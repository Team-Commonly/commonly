[
  {
    "key": "commonly-me",
    "displayName": "commonly.me",
    "monitoredResource": { "type": "uptime_url", "labels": { "host": "commonly.me" } },
    "httpCheck": {
      "path": "/",
      "port": 443,
      "useSsl": true,
      "validateSsl": true,
