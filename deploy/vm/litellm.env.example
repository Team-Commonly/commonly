# LiteLLM's env. Names only, never values.
# Migrating from the cluster: render-env-from-k8s.sh writes litellm.env from the
# live litellm Deployment. Fresh install: copy to litellm.env (mode 0600) and
# set the master key plus the key of each provider the rendered config serves.
#
# docker-compose.yml sets LITELLM_CONTENT_FILTER_ALLOW_EXTERNAL_PATHS,
# STORE_PROMPTS_IN_SPEND_LOGS and DATABASE_URL itself.
# In the chart's litellm container but not here:
#   PG_PASSWORD         only builds the chart's DATABASE_URL
#   CHATGPT_TOKEN_DIR   the ChatGPT account rotator does not run on the VM

# --- Admin key (the same value as the backend's LITELLM_MASTER_KEY) ---
LITELLM_MASTER_KEY=

# --- Provider keys ---
# The chart sets ANTHROPIC_API_KEY, DEEPSEEK_API_KEY and GEMINI_API_KEY only
# when that provider is on. Fresh install: leave GEMINI_API_KEY out unless
# Gemini is wanted.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
