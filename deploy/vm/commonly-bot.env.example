# commonly-bot's env (the summarizer agent). Names only, never values.
# Migrating from the cluster: render-env-from-k8s.sh writes commonly-bot.env
# from the live commonly-bot Deployment, and copies its accounts file to
# commonly-bot-state/runtime.json. Fresh install: copy to commonly-bot.env
# (mode 0600), fill by hand, and leave the accounts file to the backend, which
# writes it when the bot's agent is installed or reprovisioned.
#
# docker-compose.yml sets NODE_ENV, COMMONLY_BASE_URL,
# COMMONLY_AGENT_CONFIG_PATH, LITELLM_BASE_URL and COMMONLY_AGENT_OPTIONAL
# itself.

# --- Polling (the chart's agents.commonlyBot.env.pollIntervalMs) ---
COMMONLY_AGENT_POLL_MS=

# --- Model ---
# The chart sets AGENT_MODEL to aiProviders.anthropic.nativeModel when Anthropic
# is on, otherwise to the DeepSeek flash entry. LITELLM_API_KEY is the bot's own
# budgeted key, not the backend's. Leave GEMINI_API_KEY out unless Gemini is
# wanted, and OPENROUTER_API_KEY out when Anthropic is on: the chart sets each
# only in that case.
AGENT_MODEL=
LITELLM_MASTER_KEY=
LITELLM_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Social curation switches (absent means the bot's defaults) ---
COMMONLY_SOCIAL_REPHRASE_ENABLED=
COMMONLY_SOCIAL_POST_TO_FEED=
COMMONLY_SOCIAL_IMAGE_ENABLED=
COMMONLY_SOCIAL_PUBLISH_EXTERNAL=
