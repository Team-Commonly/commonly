# The backend's env. Names only, never values.
#
# Migrating from the cluster: render-env-from-k8s.sh writes backend.env from the
# live backend Deployment, so the VM gets exactly the env prod runs. It keeps
# only the names listed here.
#
# Fresh install: copy to backend.env (mode 0600) and fill it by hand. Leave an
# unused name out: an absent name is unset, which turns most optional features
# off, while an empty value reaches the backend as an empty string. To match
# what the chart would set (k8s/helm/commonly/values.yaml), set at least:
#   FRONTEND_URL, BACKEND_URL, OAUTH_CALLBACK_BASE_URL   your public origins
#   LITELLM_CHAT_MODEL, AGENT_DEFAULT_MODEL               litellm.agentDefaultModel
#                                                         (the chat model is the
#                                                         DeepSeek flash entry when
#                                                         DeepSeek is on)
#   NATIVE_RUNTIME_MODEL, LLM_SERVICE_MODEL               aiProviders.anthropic.nativeModel,
#                                                         only when Anthropic is on
#   HOSTED_MCP_HIDDEN_ENTRIES                             hostedMcp.hiddenEntries as JSON
#                                                         (an empty list is [])
#   HOSTED_MCP_HIDDEN_ENTRY_USER_ALLOWLIST                JSON object ({} when empty)
#   REGISTRATION_INVITE_ONLY                              0 for open sign-up
# Leave GEMINI_API_KEY out unless Gemini is wanted: the chart sets it only when
# aiProviders.gemini is on.
#
# docker-compose.yml sets these itself, overriding this file: NODE_ENV, PORT,
# PG_HOST, PG_PORT, PG_DATABASE, PG_USER, PG_PASSWORD, PG_SSL_ENABLED,
# LITELLM_BASE_URL, COMMONLY_API_URL, AGENT_PROVISIONER_K8S,
# AGENT_PROVISIONER_DOCKER, AGENT_COMPUTER_ENABLED, LLMSERVICE_GUARDRAILS,
# SKILLS_CATALOG_PATH, MARKETPLACE_MANIFEST_PATH, SENTRY_RELEASE.
#
# In the chart's backend env but left out on the VM:
#   RUN_WORKER, NATIVE_TURNS_ON_WORKER   one container does web and worker
#   K8S_NAMESPACE, AGENT_PROVISIONER_NODE_POOL, CODEX_BYPASS_LITELLM,
#   AGENT_RUNTIME_SERVICE_ACCOUNT
#                                        agent provisioning into Kubernetes pods
#   AGENT_COMPUTER_STEEL_API_URL_TEMPLATE, AGENT_COMPUTER_STEEL_CDP_URL_TEMPLATE,
#   AGENT_COMPUTER_ALLOWED_HOSTS, AGENT_COMPUTER_WAKER_URL,
#   AGENT_COMPUTER_WAKER_TOKEN, AGENT_COMPUTER_STEEL_TOKEN
#                                        the agent computer runs as cluster pods
#   E2B_API_KEY                          hosted sandbox, off on the VM
#   REDIS_HOST, REDIS_PORT, REDIS_PASSWORD
#                                        Redis is only used with Kubernetes
#                                        provisioning on; no Redis runs here
#   PG_CA_CERT_PATH, PG_SSL_CA_PATH      no TLS to the local Postgres
#   GOOGLE_APPLICATION_CREDENTIALS, GCP_PROJECT_ID
#                                        the cluster's secret-store wiring
#   SESSION_SECRET, COMMONLY_BOT_RUNTIME_TOKEN
#                                        no backend code reads them

# --- Core ---
MONGO_URI=
PG_POOL_MAX=
JWT_SECRET=
FRONTEND_URL=
BACKEND_URL=
OAUTH_CALLBACK_BASE_URL=
LOG_LEVEL=
SENTRY_DSN=

