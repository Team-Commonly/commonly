# Stack settings for deploy/vm/docker-compose.yml. Names only, never values.
# Copy to .env at mode 0600 and fill by hand from the secret store, with each
# value in single quotes (KEY='value') so compose never expands a `$` in it. Compose
# reads this file only to fill ${...} in docker-compose.yml: no service gets it
# whole, and each value reaches only the services that name it.
# The app's own env lives in backend.env, litellm.env and backup.env.

# --- Images (the registry path without a trailing slash; the tag is the deploy's short SHA) ---
COMMONLY_IMAGE_REGISTRY=
COMMONLY_IMAGE_TAG=

# --- Tunnel (cloudflared only) ---
TUNNEL_TOKEN=

# --- Postgres on the VM ---
# Admin role (backups and restores), app role (backend) and LiteLLM's role.
# Use URL-safe passwords: LiteLLM's goes into a connection URL.
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=
PG_DATABASE=
PG_USER=
PG_PASSWORD=
LITELLM_PG_USER=
LITELLM_PG_PASSWORD=

# --- Backups (pg-backup only) ---
# R2 endpoint: https://<account>.r2.cloudflarestorage.com. The key needs object
# read and write on this one bucket. Optional: prefix (default commonly),
# retention days (14), hour in UTC 0-23 (2), the smallest Mongo archive in
# bytes that counts as a real backup (65536), and hours between extra
# Postgres-only dumps (0, off; 6 keeps message loss under 6 hours).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=
BACKUP_RETENTION_DAYS=
BACKUP_HOUR_UTC=
BACKUP_MONGO_MIN_BYTES=
BACKUP_PG_EVERY_HOURS=
