      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "url",
        "expiresAt",
        "usesLeft"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^inv_[0-9A-Za-z]{22}$"
