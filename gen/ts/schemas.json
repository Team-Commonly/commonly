    "ClaimRunResponse": {
      "description": "The brief is built by the server and sent as the agent's first prompt. The run token goes to the agent; the computer token never does.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "runToken",
        "brief",
        "mcpUrl",
        "expiresAt"
      ],
      "properties": {
