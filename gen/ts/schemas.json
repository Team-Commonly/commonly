          "$ref": "#/$defs/RunId"
        },
        "runToken": {
          "$ref": "#/$defs/RunToken"
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "mcpUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
