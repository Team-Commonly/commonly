{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonly.me/v4/schema/bundle.json",
  "$comment": "Code generated by scripts/gen.mjs from schema/. DO NOT EDIT.",
  "$defs": {
    "PodId": {
      "type": "string",
      "pattern": "^pod_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "UserId": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "AgentId": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ActorId": {
      "description": "A user or an agent: who a task is assigned to, or who acted. System actors use sys_.",
      "type": "string",
      "pattern": "^(usr|agt|sys)_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ComputerId": {
      "type": "string",
      "pattern": "^cmp_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "TaskId": {
      "type": "string",
      "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "MessageId": {
      "type": "string",
      "pattern": "^msg_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "DecisionId": {
      "type": "string",
      "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "WakeId": {
      "type": "string",
      "pattern": "^wak_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Seq": {
      "description": "Monotonic per pod, assigned by the pod. Starts at 1.",
      "type": "integer",
      "minimum": 1
    },
    "Timestamp": {
      "description": "RFC 3339 in UTC. Set by the server only.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "ActorKind": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "system"
      ]
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "displayName"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "id": {
          "$ref": "#/$defs/ActorId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "Harness": {
      "description": "Which agent program a registered agent runs. fake is the deterministic test agent.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "fake"
      ]
    },
    "ErrorCode": {
      "description": "Stable error codes, shared by HTTP responses, MCP tool errors and the socket error event.",
      "type": "string",
      "enum": [
        "invalid_input",
        "summary_required",
        "unauthorized",
        "forbidden",
        "not_found",
        "gone",
        "already_claimed",
        "already_ruled",
        "authorization_pending",
        "slow_down",
        "expired_token",
        "invalid_grant",
        "rate_limited",
        "internal"
      ]
    },
    "ErrorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "field": {
          "description": "The input field at fault, when there is one.",
          "type": "string",
          "maxLength": 80
        },
        "ref": {
          "description": "The id the error is about, when there is one.",
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "TokenKind": {
      "type": "string",
      "enum": [
        "user",
        "computer",
        "run"
      ]
    },
    "UserToken": {
      "description": "Bound to one user. 30 days, refreshable.",
      "type": "string",
      "pattern": "^cmu_[0-9A-Za-z]{43}$"
    },
    "ComputerToken": {
      "description": "Bound to one user and one computer. Valid until revoked.",
      "type": "string",
      "pattern": "^cmc_[0-9A-Za-z]{43}$"
    },
    "RunToken": {
      "description": "Bound to one agent, pod and run (and task, if any). Ends with the run; at most 2 hours.",
      "type": "string",
      "pattern": "^cmr_[0-9A-Za-z]{43}$"
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "blocked",
        "done",
        "failed"
      ]
    },
    "Claim": {
      "description": "One active claim per task. The lease is renewed by any MCP call on the claiming run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "runId",
        "leaseUntil"
      ],
      "properties": {
        "by": {
          "$ref": "#/$defs/Actor"
        },
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "leaseUntil": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "podId",
        "title",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/TaskId"
        },
        "podId": {
          "$ref": "#/$defs/PodId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "maxLength": 16384
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "assignee": {
          "$ref": "#/$defs/ActorId"
        },
        "createdBy": {
          "$ref": "#/$defs/Actor"
        },
        "claim": {
          "$ref": "#/$defs/Claim"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "MessageKind": {
      "type": "string",
      "enum": [
        "result",
        "ask",
        "progress",
        "fyi",
        "error"
      ]
    },
    "MessageStatus": {
      "type": "string",
      "enum": [
        "done",
        "in_progress",
        "blocked",
        "failed"
      ]
    },
    "NeedsAction": {
      "type": "string",
      "enum": [
        "approve",
        "decide",
        "review",
        "answer",
        "unblock"
      ]
    },
    "MemberRole": {
      "type": "string",
      "enum": [
        "member",
        "owner"
      ]
    },
    "NeedsTarget": {
      "description": "Exactly one of userIds or role.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "userIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/UserId"
          }
        },
        "role": {
          "$ref": "#/$defs/MemberRole"
        }
      }
    },
    "Needs": {
      "description": "The only field that notifies anyone. progress and fyi posts never notify.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to",
        "action"
      ],
      "properties": {
        "to": {
          "$ref": "#/$defs/NeedsTarget"
        },
        "action": {
          "$ref": "#/$defs/NeedsAction"
        }
      }
    },
    "OptionId": {
      "type": "string",
      "enum": [
        "a",
        "b",
        "c",
        "d",
        "e"
      ]
    },
    "Option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/OptionId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 160
        },
        "recommended": {
          "type": "boolean"
        }
      }
    },
    "LinkType": {
      "type": "string",
      "enum": [
        "pr",
        "commit",
        "task",
        "doc",
        "file",
        "log"
      ]
    },
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url",
        "type"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "url": {
          "description": "https only, and no credentials in the URL.",
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[^/\\s@]+(/[^\\s]*)?$"
        },
        "type": {
          "$ref": "#/$defs/LinkType"
        }
      }
    },
    "WakeReason": {
      "type": "string",
      "enum": [
        "task_assigned",
        "mention",
        "decision_ruled"
      ]
    },
    "Receipt": {
      "description": "Stamped by the pod from the run record. An agent can't write any of it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "agentId",
        "computerId",
        "harness",
        "startedAt",
        "postedAt",
        "toolCalls",
        "wakeReason"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "agentId": {
          "$ref": "#/$defs/AgentId"
        },
        "computerId": {
          "$ref": "#/$defs/ComputerId"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "harnessVersion": {
          "description": "Reported by the daemon at session start.",
          "type": "string",
          "maxLength": 64
        },
        "startedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "postedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "toolCalls": {
          "description": "MCP calls the pod saw on this run's token.",
          "type": "integer",
          "minimum": 0
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "wakeReason": {
          "$ref": "#/$defs/WakeReason"
        }
      }
    },
    "DecisionState": {
      "type": "string",
      "enum": [
        "open",
        "ruled",
        "expired"
      ]
    },
    "Ruling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optionId",
        "by",
        "at"
      ],
      "properties": {
        "optionId": {
          "$ref": "#/$defs/OptionId"
        },
        "by": {
          "$ref": "#/$defs/Actor"
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/DecisionId"
        },
        "state": {
          "$ref": "#/$defs/DecisionState"
        },
        "ruling": {
          "$ref": "#/$defs/Ruling"
        }
      }
    },
    "PostInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "kind",
        "status"
      ],
      "properties": {
        "summary": {
          "description": "The headline, outcome first. One line, at most 120 characters.",
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\r\\n]*$"
        },
        "kind": {
          "$ref": "#/$defs/MessageKind"
        },
        "status": {
          "$ref": "#/$defs/MessageStatus"
        },
        "needs": {
          "$ref": "#/$defs/Needs"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "links": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Link"
          }
        },
        "caveat": {
          "description": "What isn't verified.",
          "type": "string",
          "maxLength": 160
        },
        "body": {
          "description": "Markdown. Folded by default in clients.",
          "type": "string",
          "maxLength": 16384
        }
      }
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "seq",
        "podId",
        "author",
        "createdAt",
        "summary",
        "kind",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "podId": {
          "$ref": "#/$defs/PodId"
        },
        "author": {
          "$ref": "#/$defs/Actor"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "threadOf": {
          "$ref": "#/$defs/MessageId"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\r\\n]*$"
        },
        "kind": {
          "$ref": "#/$defs/MessageKind"
        },
        "status": {
          "$ref": "#/$defs/MessageStatus"
        },
        "needs": {
          "$ref": "#/$defs/Needs"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "links": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Link"
          }
        },
        "caveat": {
          "type": "string",
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "maxLength": 16384
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "receipt": {
          "$ref": "#/$defs/Receipt"
        }
      }
    },
    "EventType": {
      "type": "string",
      "enum": [
        "hello",
        "message.created",
        "message.updated",
        "task.created",
        "task.updated",
        "task.claimed",
        "presence.changed",
        "run.wake",
        "error",
        "subscribe",
        "message.post",
        "task.create",
        "decision.rule",
        "presence.heartbeat",
        "wake.ack",
        "daemon.status"
      ]
    },
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "podId",
        "data"
      ],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "$ref": "#/$defs/EventType"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "podId": {
          "$ref": "#/$defs/PodId"
        },
        "ts": {
          "$ref": "#/$defs/Timestamp"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "data": {
          "description": "Matches the definition x-variants names for type.",
          "type": "object"
        }
      }
    },
    "Member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "role"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "role": {
          "$ref": "#/$defs/MemberRole"
        }
      }
    },
    "PresenceState": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "working"
      ]
    },
    "AgentPresence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "harness",
        "computerId",
        "state"
      ],
      "properties": {
        "agent": {
          "$ref": "#/$defs/Actor"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "computerId": {
          "$ref": "#/$defs/ComputerId"
        },
        "state": {
          "$ref": "#/$defs/PresenceState"
        }
      }
    },
    "Hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "podId",
        "headSeq",
        "you",
        "members",
        "agents"
      ],
      "properties": {
        "podId": {
          "$ref": "#/$defs/PodId"
        },
        "headSeq": {
          "description": "0 for an empty pod.",
          "type": "integer",
          "minimum": 0
        },
        "you": {
          "$ref": "#/$defs/Actor"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Member"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentPresence"
          }
        }
      }
    },
    "MessageUpdated": {
      "description": "Only a decision changes after a message is created. The summary never changes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "decision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        }
      }
    },
    "TaskClaimed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "by",
        "runId",
        "leaseUntil"
      ],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "by": {
          "$ref": "#/$defs/Actor"
        },
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "leaseUntil": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "PresenceChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "state"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "state": {
          "$ref": "#/$defs/PresenceState"
        },
        "computerId": {
          "$ref": "#/$defs/ComputerId"
        }
      }
    },
    "WakeRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "messageId": {
          "$ref": "#/$defs/MessageId"
        },
        "decisionId": {
          "$ref": "#/$defs/DecisionId"
        }
      }
    },
    "RunWake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wakeId",
        "agentId",
        "reason",
        "refs"
      ],
      "properties": {
        "wakeId": {
          "$ref": "#/$defs/WakeId"
        },
        "agentId": {
          "$ref": "#/$defs/AgentId"
        },
        "reason": {
          "$ref": "#/$defs/WakeReason"
        },
        "refs": {
          "$ref": "#/$defs/WakeRefs"
        }
      }
    },
    "Subscribe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sinceSeq"
      ],
      "properties": {
        "sinceSeq": {
          "description": "0 replays from the start of the kept log.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "MessagePost": {
      "description": "A human post.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "threadOf": {
          "$ref": "#/$defs/MessageId"
        }
      }
    },
    "TaskCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "assignee": {
          "$ref": "#/$defs/ActorId"
        },
        "body": {
          "type": "string",
          "maxLength": 16384
        }
      }
    },
    "DecisionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "optionId"
      ],
      "properties": {
        "decisionId": {
          "$ref": "#/$defs/DecisionId"
        },
        "optionId": {
          "$ref": "#/$defs/OptionId"
        }
      }
    },
    "PresenceHeartbeat": {
      "description": "Every 15 s from the daemon.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "$ref": "#/$defs/ComputerId"
        }
      }
    },
    "WakeAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wakeId"
      ],
      "properties": {
        "wakeId": {
          "$ref": "#/$defs/WakeId"
        }
      }
    },
    "ComputerStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "online"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ComputerId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "online": {
          "type": "boolean"
        }
      }
    },
    "RunStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "agentId",
        "startedAt"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "agentId": {
          "$ref": "#/$defs/AgentId"
        },
        "startedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        }
      }
    },
    "DaemonStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "computers",
        "agents",
        "runs"
      ],
      "properties": {
        "computers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComputerStatus"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentPresence"
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunStatus"
          }
        }
      }
    },
    "DeviceStartResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceCode",
        "userCode",
        "verificationUri",
        "interval",
        "expiresIn"
      ],
      "properties": {
        "deviceCode": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128
        },
        "userCode": {
          "description": "What the person types on the sign-in page, e.g. WDJB-MJHT.",
          "type": "string",
          "pattern": "^[BCDFGHJKLMNPQRSTVWXZ]{4}-[BCDFGHJKLMNPQRSTVWXZ]{4}$"
        },
        "verificationUri": {
          "type": "string",
          "pattern": "^https?://"
        },
        "interval": {
          "description": "Seconds between polls.",
          "type": "integer",
          "minimum": 1
        },
        "expiresIn": {
          "description": "Seconds until the code expires.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "DeviceTokenRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceCode"
      ],
      "properties": {
        "deviceCode": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128
        }
      }
    },
