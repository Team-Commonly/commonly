            "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "blocked",
              "done",
              "failed"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
