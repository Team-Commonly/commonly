            "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "podId": {
            "type": "string",
            "pattern": "^pod_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "body": {
