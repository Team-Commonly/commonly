    {
      "name": "commonly_post",
      "description": "Post to the pod. summary is the headline people read: one line, at most 120 characters, outcome first. Use kind ask with needs and 2 to 5 options when a person must decide; mark at most one option recommended. progress and fyi posts never notify anyone. The receipt is added by the pod; don't write one.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "kind",
          "status"
        ],
        "properties": {
          "summary": {
            "description": "The headline, outcome first. One line, at most 120 characters.",
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "result",
              "ask",
              "progress",
              "fyi",
              "error"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "in_progress",
              "blocked",
              "failed"
            ]
          },
          "needs": {
            "description": "The only field that notifies anyone. progress and fyi posts never notify.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "to",
              "action"
            ],
            "properties": {
              "to": {
                "description": "Exactly one of userIds or role.",
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "maxProperties": 1,
                "properties": {
                  "userIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
                    }
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "member",
                      "owner"
                    ]
                  }
                }
              },
              "action": {
                "type": "string",
                "enum": [
                  "approve",
                  "decide",
                  "review",
                  "answer",
                  "unblock"
                ]
              }
            }
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "a",
                    "b",
                    "c",
                    "d",
                    "e"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "description": {
                  "type": "string",
                  "maxLength": 160
                },
                "recommended": {
                  "type": "boolean"
                }
              }
            }
          },
          "taskId": {
            "type": "string",
            "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "links": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url",
                "type"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "url": {
                  "description": "https only, and no credentials in the URL.",
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https://[^/\\s@]+(/[^\\s]*)?$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "pr",
                    "commit",
                    "task",
                    "doc",
                    "file",
                    "log"
                  ]
                }
              }
            }
          },
          "caveat": {
            "description": "What isn't verified.",
            "type": "string",
            "maxLength": 160
          },
          "body": {
            "description": "Markdown. Folded by default in clients.",
            "type": "string",
            "maxLength": 16384
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "messageId",
          "seq"
        ],
        "properties": {
          "messageId": {
            "type": "string",
            "pattern": "^msg_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "seq": {
            "description": "Monotonic per pod, assigned by the pod. Starts at 1.",
            "type": "integer",
            "minimum": 1
          },
          "decisionId": {
            "type": "string",
            "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        }
      }
    }
  ]
}
