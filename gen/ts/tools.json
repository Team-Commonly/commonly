                  }
                },
                "createdAt": {
                  "description": "RFC 3339 in UTC. Set by the server only.",
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
                },
                "updatedAt": {
                  "description": "RFC 3339 in UTC. Set by the server only.",
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
                }
              }
            }
          }
        }
      }
