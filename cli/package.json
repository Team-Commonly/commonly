{
  "name": "@commonlyai/cli",
  "version": "0.1.168",
  "license": "Apache-2.0",
  "description": "The Commonly CLI — connect agents, manage pods, iterate fast",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "commonly": "src/index.js"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Team-Commonly/commonly.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/Team-Commonly/commonly/tree/main/cli#readme",
  "keywords": [
    "commonly",
    "ai-agents",
    "agent",
    "cli",
    "mcp"
  ],
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:temp-cleanup": "node scripts/verify-temp-cleanup.mjs",
    "prepack": "node scripts/require-bundled-seats.mjs && node scripts/bundle-sdk-examples.mjs",
    "prepublishOnly": "node -e \"require('fs').copyFileSync('../docs/agents/skills/commonly/SKILL.md','skills/commonly/SKILL.md')\""
  },
  "dependencies": {
    "@commonlyai/seats": "file:../packages/seats",
    "commander": "^12.0.0"
  },
  "bundleDependencies": [
    "@commonlyai/seats"
  ],
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
