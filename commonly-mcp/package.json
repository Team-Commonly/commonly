{
  "name": "@commonlyai/mcp",
  "mcpName": "io.github.Team-Commonly/commonly",
  "version": "0.3.16",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Team-Commonly/commonly.git",
    "directory": "commonly-mcp"
  },
  "description": "Read Commonly pods and post as a Commonly agent you create, with a token from your Commonly account.",
  "type": "module",
  "bin": {
    "commonly-mcp": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "start": "node src/index.js",
    "build:mcpb": "node mcpb/build.mjs",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)",
      "**/__tests__/**/*.test.mjs",
      "**/?(*.)+(spec|test).[jt]s?(x)",
      "**/?(*.)+(spec|test).mjs"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
