{
  "revision": {
    "catalogId": "commonly.ui",
    "catalogRev": 3,
    "catalogHash": "sha256:b2d601737b88addd13814a962dead835f5a6b72381ae8dc215a0ff79c641b9f6"
  },
  "grammar": {
    "$defs": {
      "Card": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "children": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Card"
                },
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/List"
                },
                {
                  "$ref": "#/$defs/Steps"
                },
                {
                  "$ref": "#/$defs/DiffSummary"
                },
                {
                  "$ref": "#/$defs/TaskStatus"
                },
                {
                  "$ref": "#/$defs/KeyValue"
                },
                {
                  "$ref": "#/$defs/Table"
                },
                {
                  "$ref": "#/$defs/Badge"
                },
                {
                  "$ref": "#/$defs/Link"
                },
                {
                  "$ref": "#/$defs/RunTrace"
                },
                {
                  "$ref": "#/$defs/Progress"
                },
                {
                  "$ref": "#/$defs/BarChart"
                },
                {
                  "$ref": "#/$defs/LineChart"
                },
                {
                  "$ref": "#/$defs/Button"
                }
              ]
            },
            "minItems": 1,
            "maxItems": 8
          },
          "meta": {
            "type": "string",
            "maxLength": 32
          },
          "summary": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "title",
          "children"
        ],
        "additionalProperties": false
      },
      "Text": {
        "type": "object",
        "properties": {
          "body": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 600
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 600
                    },
                    {
                      "$ref": "#/$defs/Link"
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "body"
        ],
        "additionalProperties": false
      },
      "List": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "minItems": 1,
            "maxItems": 8
          },
          "ordered": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Steps": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Step"
            },
            "minItems": 2,
            "maxItems": 8
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      },
      "Step": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "done",
              "failed",
              "skipped"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "label",
          "state"
        ],
        "additionalProperties": false
      },
      "DiffSummary": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/File"
            }
          }
        },
        "required": [
          "files"
        ],
        "additionalProperties": false
      },
      "File": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "added": {
            "type": "integer",
            "minimum": 0
          },
          "removed": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "added",
          "removed"
        ],
        "additionalProperties": false
      },
      "TaskStatus": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "taskId"
        ],
        "additionalProperties": false
      },
      "KeyValue": {
        "type": "object",
        "properties": {
          "pairs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Pair"
            }
          }
        },
        "required": [
          "pairs"
        ],
        "additionalProperties": false
      },
      "Pair": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      },
      "Table": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Col"
            },
            "minItems": 1
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "required": [
          "columns",
          "rows"
        ],
        "additionalProperties": false
      },
      "Col": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      },
      "Badge": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 24
          },
          "tone": {
            "type": "string",
            "enum": [
              "neutral",
              "ink",
              "done",
              "failed",
              "pending"
            ]
          }
        },
        "required": [
          "label",
          "tone"
        ],
        "additionalProperties": false
      },
      "Link": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "url": {
            "type": "string"
          },
          "as": {
            "type": "string",
            "enum": [
              "text",
              "button",
              "primary"
            ]
          }
        },
        "required": [
          "label",
          "url",
          "as"
        ],
        "additionalProperties": false
      },
      "RunTrace": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3
          }
        },
        "required": [
          "limit"
        ],
        "additionalProperties": false
      },
      "Progress": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "label": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "BarChart": {
        "type": "object",
        "properties": {
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 24
            },
            "minItems": 1,
            "maxItems": 24
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Series"
            },
            "minItems": 1,
            "maxItems": 4
          },
          "variant": {
            "type": "string",
            "enum": [
              "grouped",
              "stacked"
            ]
          },
          "xLabel": {
            "type": "string",
            "maxLength": 40
          },
          "yLabel": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "labels",
          "series"
        ],
        "additionalProperties": false
      },
      "LineChart": {
        "type": "object",
        "properties": {
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 24
            },
            "minItems": 1,
            "maxItems": 24
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Series"
            },
            "minItems": 1,
            "maxItems": 4
          },
          "xLabel": {
            "type": "string",
            "maxLength": 40
          },
          "yLabel": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "labels",
          "series"
        ],
        "additionalProperties": false
      },
      "Series": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "maxLength": 24
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 24
          }
        },
        "required": [
          "category",
          "values"
        ],
        "additionalProperties": false
      },
      "Button": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "action": {
            "type": "object",
            "properties": {
              "k": {
                "const": "Comp"
              },
              "name": {
                "const": "Action"
              },
              "args": {
                "type": "array"
              }
            },
            "required": [
              "k",
              "name",
              "args"
            ]
          },
          "as": {
            "type": "string",
            "enum": [
              "button",
              "primary"
            ]
          }
        },
        "required": [
          "label",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "properties": {
      "Card": {
        "$ref": "#/$defs/Card"
      },
      "Text": {
        "$ref": "#/$defs/Text"
      },
      "List": {
        "$ref": "#/$defs/List"
      },
      "Steps": {
        "$ref": "#/$defs/Steps"
      },
      "Step": {
        "$ref": "#/$defs/Step"
      },
      "DiffSummary": {
        "$ref": "#/$defs/DiffSummary"
      },
      "File": {
        "$ref": "#/$defs/File"
      },
      "TaskStatus": {
        "$ref": "#/$defs/TaskStatus"
      },
      "KeyValue": {
        "$ref": "#/$defs/KeyValue"
      },
      "Pair": {
        "$ref": "#/$defs/Pair"
      },
      "Table": {
        "$ref": "#/$defs/Table"
      },
      "Col": {
        "$ref": "#/$defs/Col"
      },
      "Badge": {
        "$ref": "#/$defs/Badge"
      },
      "Link": {
        "$ref": "#/$defs/Link"
      },
      "RunTrace": {
        "$ref": "#/$defs/RunTrace"
      },
      "Progress": {
        "$ref": "#/$defs/Progress"
      },
      "BarChart": {
        "$ref": "#/$defs/BarChart"
      },
      "LineChart": {
        "$ref": "#/$defs/LineChart"
      },
      "Series": {
        "$ref": "#/$defs/Series"
      },
      "Button": {
        "$ref": "#/$defs/Button"
      }
    }
  },
  "examples": [
    {
      "title": "Status with a badge and a sentence",
      "source": "root = Card(\"Build status\", [Badge(\"Passing\", \"done\"), Text(\"All 412 checks passed on main at 2c1f9a0.\")])"
    },
    {
      "title": "Ordered steps with one active step",
      "source": "root = Card(\"Release steps\", [Steps([Step(\"Merge\", \"done\", \"PR #3094\"), Step(\"Deploy dev\", \"active\", \"Running\"), Step(\"Verify live\", \"pending\", \"After deploy\")])])"
    },
    {
      "title": "Table of results with one link",
      "source": "root = Card(\"Open PRs\", [Table([Col(\"PR\", \"text\"), Col(\"Age\", \"text\")], [[\"#3094\", \"2h\"], [\"#3107\", \"40m\"]]), Link(\"Open the board\", \"https://commonly.me\", \"button\")])"
    },
    {
      "title": "Progress and a bar chart",
      "source": "root = Card(\"Sprint 14\", [Progress(62, \"Done\"), BarChart([\"Mon\", \"Tue\", \"Wed\"], [Series(\"Merged\", [3, 5, 2]), Series(\"Opened\", [4, 2, 6])], \"grouped\", \"Day\", \"PRs\")])"
    },
    {
      "title": "A choice the person makes with buttons (wakes you with decision.ruled)",
      "source": "root = Card(\"Ship the release?\", [Text(\"Checks are green on main.\"), Button(\"Ship it\", Action(@ToAssistant(\"ship\")), \"primary\"), Button(\"Hold\", Action(@ToAssistant(\"hold\")))])"
    }
  ]
}
